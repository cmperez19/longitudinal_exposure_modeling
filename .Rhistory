outcome_var <- c("length_cm","weight_kg", "adjusted_fat_mass_kg", "lean_mass_kg", "total_body_water_kg", "fmi", "ffmi")
lmm_results <- list()
# Loop through each outcome variable
for (outcome in outcome_var) {
# Construct the formula as a string
formula_str <- paste(
outcome, "~ PFHxS.L_6 + PFHxS.L_24 + PFHxS.Total_6 + PFHxS.Total_24",
"+ PFOS.L_6 + PFOS.L_24 + PFOS.Br_6 + PFOS.Br_24 + PFOS.Total_6 + PFOS.Total_24",
"+ PFOA_6 + PFOA_24 + PFNA_6 + PFNA_24 + (1 | StudyID.GE) + maternal_bmi + sex +    gest_age_wk + mom_ed"
)
# Convert the string to a formula
model_formula <- as.formula(formula_str)
# Fit the model
lmm_fit <- lmer(model_formula, data = outcome_data)
# Store the model, named by outcome
lmm_results[[outcome]] <- lmm_fit
}
outcome_data
