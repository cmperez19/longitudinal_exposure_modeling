outcome_data$Visitmo
outcome_data$Visitmo[1]
outcome_data <- growth_modeling %>%
filter(visit_name %in% c("Post-24mo", "Post-6mo")  ) %>%
select(id, visit_name, length_cm, weight_kg, adjusted_fat_mass_kg, lean_mass_kg, fmi, ffmi, wfl_z, maternal_bmi, sex, gest_age_wk, mom_ed, bf_length_mo, lnPFHxS_T1, lnPFOS_T1, lnPFOA_T1, lnPFNA_T1, lnPFHxA_T1, lnPFBS_T1, lnPFHxS, lnPFOS, lnPFOA, lnPFNA, lnPFHxA, lnPFBS) %>%
mutate(
Visitmo = case_when(
visit_name == "Post-24mo" ~ 2,
visit_name == "Post-6mo" ~ 0.5,
TRUE ~ NA_real_))  %>%
group_by(id) %>%
filter(n() == 2) %>% #ensures we focus on data that has duplicates
ungroup()
outcome_var <- c("length_cm","weight_kg", "adjusted_fat_mass_kg", "lean_mass_kg", "fmi", "ffmi", "wfl_z")
indiv_results = list()
# Loop through each outcome variable
for (outcome in outcome_var) {
out <- vector("list", length(outcome_var))
for(pfas in c("lnPFHxS", "lnPFOS", "lnPFOA", "lnPFNA", "lnPFHxA",  "lnPFBS")) {
# Construct the formula as a string
formula_str <- paste(
outcome, "~", pfas, " + maternal_bmi + sex + bf_length_mo +  mom_ed + (1 + Visitmo | id)")
# Convert the string to a formula
model_formula <- as.formula(formula_str)
lmm_fit <- lmer(model_formula, data = outcome_data)
coef_mat <- coef(summary(lmm_fit))
ci <- confint(lmm_fit)[pfas, ]
out[[pfas]] <- data.frame(
postnatal_outcome = outcome,
pfas = pfas,
estimate  = coef_mat[pfas, "Estimate"],
conf.low  = ci[1],
conf.high = ci[2],
p.value   = coef_mat[pfas, "Pr(>|t|)"],
row.names = NULL
)
}
indiv_results[[outcome]] <- bind_rows(out)
}
as.type(outcome_data$visit_name)
is.numeric(outcome_data$visit_name)
is.numeric(outcome_data$Visitmo)
