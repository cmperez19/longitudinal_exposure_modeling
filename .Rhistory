outcome, "~ PFHxS.L_6 + PFHxS.L_24 + PFHxS.Total_6 + PFHxS.Total_24",
"+ PFOS.L_6 + PFOS.L_24 + PFOS.Br_6 + PFOS.Br_24 + PFOS.Total_6 + PFOS.Total_24",
"+ PFOA_6 + PFOA_24 + PFNA_6 + PFNA_24 + maternal_bmi + sex + gest_age_wk + mom_ed")
model_formula <- as.formula(formula_str)
lm_mod <- lm(model_formula, data = pfas_wide)
coef_mat <- coef(summary(lm_mod))
print(outcome)
print(coef_mat)
print(car::vif(lm_mod))
}
unlist(indiv_results)
knitr::kable(indiv_results, digits=2)
knitr::kable(indiv_results)
for ( i in outcome_var){
print(knitr::kable(indiv_results[[i]], digits = 3))
}
